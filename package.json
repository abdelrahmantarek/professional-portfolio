{
  "name": "professional-portfolio",
  "version": "1.0.0",
  "description": "Professional portfolio website built with Next.js 14, TypeScript, and Tailwind CSS",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "ANALYZE=true next build",
    "export": "next build && node scripts/post-export.js",
    "cap:init": "npx cap init",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run export && npx cap sync",
    "cap:sync:ios": "npm run export && npx cap sync ios",
    "cap:sync:android": "npm run export && npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "npm run cap:sync:ios && npx cap run ios",
    "cap:run:android": "npm run cap:sync:android && npx cap run android",
    "mobile:build": "npm run export && npx cap sync",
    "mobile:ios": "npm run cap:sync:ios && npx cap open ios",
    "mobile:android": "npm run cap:sync:android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "framer-motion": "^11.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.400.0",
    "next": "14.2.0",
    "next-intl": "^4.5.3",
    "next-seo": "^6.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^5.0.0"
  }
}
